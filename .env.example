# ==============================================================================
# AlgoTradingResearch Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS.
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Application Environment: 'development', 'staging', 'production'
ENVIRONMENT=development
LOG_LEVEL=INFO

# Execution Mode: MANDATORY GUARDRAIL
# Permitted modes: 'BACKTEST', 'PAPER'
# Live trading is disabled by design in this platform version.
EXECUTION_MODE=BACKTEST

# Upstox API Credentials (from https://account.upstox.com/developer/apps)
# App Name: AlgoTradingResearch
UPSTOX_API_KEY=your_api_key_here
UPSTOX_API_SECRET=your_api_secret_here
UPSTOX_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/callback

# Current Access Token (Generated via OAuth authorization flow)
# Stored securely in .env or passed via auth manager. Expires daily at 3:30 AM IST.
UPSTOX_ACCESS_TOKEN=

# Database Configuration
# Default to local SQLite for lightweight zero-dependency setup.
# Or use PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/algotrading
DATABASE_URL=sqlite+aiosqlite:///./data/algotrading.db
SYNC_DATABASE_URL=sqlite:///./data/algotrading.db

# Storage Directories
DATA_DIR=./data
REPORTS_DIR=./reports

# Portfolio & Capital Risk Management Defaults
STARTING_CAPITAL=25000.0
MAX_RISK_PER_TRADE_PCT=2.0       # Max 2% risk of equity per trade
MAX_DAILY_LOSS_PCT=5.0           # Stop trading if 5% equity lost in a single day
MAX_OPEN_POSITIONS=2             # Maximum concurrent positions (conservative for ₹25k capital)
MAX_CAPITAL_ALLOCATION_PCT=80.0  # Max 80% total account deployment

# Backtest & Slippage Settings
DEFAULT_SLIPPAGE_POINTS=0.5
DEFAULT_TRANSACTION_COST_MODEL=upstox_standard_equity_derivatives
